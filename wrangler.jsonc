{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geeken-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-12",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "327618401",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "327618402",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geeken-gate-db",
      "database_id": "23b8b79f-03af-428c-a6e3-790e81efb599"
    }
  ]
}
