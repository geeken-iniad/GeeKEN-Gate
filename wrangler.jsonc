{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geeken-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-12",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "OIDC_ISSUER": "https://geeken-gate.example.com",
    "GOOGLE_CALLBACK_URL": "https://geeken-gate.example.com/callback",
    "GOOGLE_ALLOWED_HD": "example.com"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "327618401",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "327618402",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geeken-gate-db",
      "database_id": "0af5473b-d6dc-46ec-ae2f-5c1e89c71852"
    }
  ]
}
